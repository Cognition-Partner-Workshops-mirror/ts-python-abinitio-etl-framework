{
    "_comment": [
        "Databricks Workflow: Customer CDC Pipeline (Every 4 Hours)",
        "Migrated from: scripts/run_customer_cdc.ksh",
        "",
        "Ab Initio Original (KornShell + AutoSys):",
        "  Trigger: AutoSys job JOB_CUSTOMER_CDC (runs every 4 hours)",
        "  Step 1: air sandbox run snapshot_customer.mp → Snapshot current state from source",
        "  Step 2: air sandbox run cdc_detect_customer.mp -partition 8 → Hash-based CDC comparison",
        "  Step 3: air sandbox run apply_customer_changes.mp → Apply changes to target",
        "  Step 4: air sandbox run audit_customer_changes.mp → Generate audit trail",
        "",
        "Databricks Equivalent:",
        "  Trigger: Databricks cron schedule (every 4 hours: 0 0 0/4 * * ?)",
        "  Steps 1-3 are collapsed into a single Delta MERGE operation in cdc_processor notebook",
        "  Step 4 (audit) is handled by cdc_processor's built-in audit_table parameter",
        "  The 4 separate Ab Initio graphs → 1 Databricks notebook + Delta MERGE",
        "",
        "PSET Parameter Mapping (from pset_templates/customer_cdc.pset):",
        "  SOURCE_PATH (/data/raw/customer) → source_path (cloud storage path)",
        "  TARGET_TABLE (STAGING.CUSTOMER_MASTER) → target_table (Delta table)",
        "  KEY_COLUMNS (customer_id) → key_columns",
        "  HASH_COLUMNS (customer_id,name,...) → compare_columns",
        "  PARTITION_COUNT (8) → partition_count",
        "  BATCH_SIZE (100000) → handled by Spark automatically",
        "  MAX_ERRORS (50) → max_errors",
        "  AUDIT_TABLE (AUDIT.CUSTOMER_CHANGES) → audit_table",
        "  RETENTION_DAYS (90) → Delta table retention properties"
    ],
    "name": "customer_cdc_pipeline",
    "description": "Customer CDC pipeline — detects and applies changes to customer master every 4 hours. Migrated from Ab Initio run_customer_cdc.ksh",
    "tags": {
        "team": "data-engineering",
        "pipeline": "customer_cdc",
        "migrated_from": "abinitio",
        "original_script": "scripts/run_customer_cdc.ksh",
        "autosys_job": "JOB_CUSTOMER_CDC",
        "schedule": "every_4_hours"
    },
    "schedule": {
        "quartz_cron_expression": "0 0 0/4 * * ?",
        "timezone_id": "UTC",
        "pause_status": "UNPAUSED",
        "_comment": "Every 4 hours — matches original AutoSys schedule for JOB_CUSTOMER_CDC"
    },
    "max_concurrent_runs": 1,
    "job_clusters": [
        {
            "job_cluster_key": "customer_cdc_cluster",
            "new_cluster": {
                "spark_version": "14.3.x-scala2.12",
                "node_type_id": "i3.xlarge",
                "num_workers": 4,
                "spark_conf": {
                    "spark.sql.shuffle.partitions": "16",
                    "spark.databricks.delta.optimizeWrite.enabled": "true",
                    "spark.databricks.delta.autoCompact.enabled": "true",
                    "_comment": "16 shuffle partitions — 2x Ab Initio PARTITION_COUNT=8 for Spark overhead"
                },
                "custom_tags": {
                    "pipeline": "customer_cdc"
                }
            }
        }
    ],
    "parameters": [
        {
            "name": "source_path",
            "default": "s3://data-lake-raw/customer/",
            "_comment": "Mapped from: PSET SOURCE_PATH=/data/raw/customer (customer_cdc.pset)"
        },
        {
            "name": "target_table",
            "default": "catalog.silver.customer_master",
            "_comment": "Mapped from: PSET TARGET_TABLE=STAGING.CUSTOMER_MASTER (customer_cdc.pset)"
        },
        {
            "name": "key_columns",
            "default": "customer_id",
            "_comment": "Mapped from: PSET KEY_COLUMNS=customer_id (customer_cdc.pset)"
        },
        {
            "name": "compare_columns",
            "default": "customer_id,name,address,phone,email,status",
            "_comment": "Mapped from: PSET HASH_COLUMNS=customer_id,name,address,phone,email,status (customer_cdc.pset)"
        },
        {
            "name": "partition_count",
            "default": "8",
            "_comment": "Mapped from: PSET PARTITION_COUNT=8 and -partition 8 in run_customer_cdc.ksh"
        },
        {
            "name": "max_errors",
            "default": "50",
            "_comment": "Mapped from: PSET MAX_ERRORS=50 (customer_cdc.pset)"
        },
        {
            "name": "audit_table",
            "default": "catalog.audit.customer_changes",
            "_comment": "Mapped from: PSET AUDIT_TABLE=AUDIT.CUSTOMER_CHANGES (customer_cdc.pset)"
        },
        {
            "name": "enable_deletes",
            "default": "true",
            "_comment": "Full CDC with deletes — matches Ab Initio CDCProcessor delete detection"
        }
    ],
    "tasks": [
        {
            "task_key": "customer_cdc_merge",
            "description": "Full CDC pipeline: snapshot → compare → merge → audit. Replaces 4 Ab Initio graphs (snapshot_customer.mp, cdc_detect_customer.mp, apply_customer_changes.mp, audit_customer_changes.mp) with a single Delta MERGE notebook.",
            "job_cluster_key": "customer_cdc_cluster",
            "notebook_task": {
                "notebook_path": "/Repos/data-engineering/databricks/notebooks/cdc_processor",
                "base_parameters": {
                    "source_path": "{{job.parameters.source_path}}",
                    "source_format": "csv",
                    "target_table": "{{job.parameters.target_table}}",
                    "key_columns": "{{job.parameters.key_columns}}",
                    "compare_columns": "{{job.parameters.compare_columns}}",
                    "partition_count": "{{job.parameters.partition_count}}",
                    "max_errors": "{{job.parameters.max_errors}}",
                    "audit_table": "{{job.parameters.audit_table}}",
                    "enable_deletes": "{{job.parameters.enable_deletes}}",
                    "delimiter": ","
                }
            },
            "timeout_seconds": 3600,
            "max_retries": 2,
            "retry_on_timeout": true,
            "min_retry_interval_millis": 60000,
            "_comment": "2 retries with 60s backoff — more resilient than Ab Initio set -e (abort immediately)"
        }
    ],
    "email_notifications": {
        "on_failure": ["data-engineering-alerts@company.com"],
        "on_success": [],
        "no_alert_for_skipped_runs": true
    },
    "webhook_notifications": {
        "on_failure": [
            {
                "id": "{{SLACK_WEBHOOK_ID}}",
                "_comment": "Slack alert — migrated from monitoring/job_monitor.py _send_alert()"
            }
        ]
    }
}
