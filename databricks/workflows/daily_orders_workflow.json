{
  "name": "daily_orders_pipeline",
  "description": "Daily Orders Pipeline — migrated from scripts/run_daily_orders.ksh (AutoSys: JOB_DAILY_ORDERS_LOAD). Runs: extract → CDC → staging → production load.",
  "tags": {
    "team": "data-engineering",
    "source": "ab_initio_migration",
    "original_script": "scripts/run_daily_orders.ksh",
    "autosys_job": "JOB_DAILY_ORDERS_LOAD"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 4,
        "spark_conf": {
          "spark.sql.shuffle.partitions": "4",
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        },
        "custom_tags": {
          "pipeline": "daily_orders",
          "cost_center": "data-engineering"
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "batch_date",
      "default": "{{job.start_time.iso_date}}"
    },
    {
      "name": "source_path",
      "default": "/data/raw/orders"
    },
    {
      "name": "target_table",
      "default": "catalog.bronze.orders"
    },
    {
      "name": "staging_table",
      "default": "catalog.silver.orders"
    },
    {
      "name": "production_table",
      "default": "catalog.gold.orders"
    },
    {
      "name": "partition_count",
      "default": "4"
    },
    {
      "name": "max_errors",
      "default": "100"
    },
    {
      "name": "log_level",
      "default": "INFO"
    },
    {
      "name": "checkpoint_dir",
      "default": "/tmp/checkpoints/orders"
    }
  ],
  "tasks": [
    {
      "task_key": "extract_orders",
      "description": "Phase 1: Extract from source systems (replaces air sandbox run extract_orders.mp)",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/data-engineering/databricks/notebooks/parallel_loader",
        "base_parameters": {
          "source_path": "{{job.parameters.source_path}}",
          "target_table": "{{job.parameters.target_table}}",
          "partition_count": "{{job.parameters.partition_count}}",
          "batch_date": "{{job.parameters.batch_date}}",
          "max_errors": "{{job.parameters.max_errors}}",
          "checkpoint_dir": "{{job.parameters.checkpoint_dir}}",
          "log_level": "{{job.parameters.log_level}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    },
    {
      "task_key": "cdc_detection",
      "description": "Phase 2: CDC detection (replaces air sandbox run cdc_orders.mp with -partition 4)",
      "depends_on": [
        {
          "task_key": "extract_orders"
        }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/data-engineering/databricks/notebooks/cdc_processor",
        "base_parameters": {
          "source_path": "{{job.parameters.source_path}}",
          "target_table": "{{job.parameters.staging_table}}",
          "key_columns": "order_id",
          "partition_count": "{{job.parameters.partition_count}}",
          "max_errors": "{{job.parameters.max_errors}}",
          "audit_table": "catalog.audit.orders_cdc_log",
          "run_timestamp": "{{job.parameters.batch_date}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    },
    {
      "task_key": "load_staging",
      "description": "Phase 3: Load to staging (replaces air sandbox run load_staging_orders.mp)",
      "depends_on": [
        {
          "task_key": "cdc_detection"
        }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/data-engineering/databricks/notebooks/parallel_loader",
        "base_parameters": {
          "source_path": "{{job.parameters.staging_table}}",
          "target_table": "catalog.silver.orders_staged",
          "partition_count": "{{job.parameters.partition_count}}",
          "batch_date": "{{job.parameters.batch_date}}",
          "max_errors": "{{job.parameters.max_errors}}",
          "checkpoint_dir": "{{job.parameters.checkpoint_dir}}/staging",
          "log_level": "{{job.parameters.log_level}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    },
    {
      "task_key": "production_rollover",
      "description": "Phase 4: Production load (replaces air sandbox run prod_rollover_orders.mp)",
      "depends_on": [
        {
          "task_key": "load_staging"
        }
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/data-engineering/databricks/notebooks/parallel_loader",
        "base_parameters": {
          "source_path": "catalog.silver.orders_staged",
          "target_table": "{{job.parameters.production_table}}",
          "partition_count": "{{job.parameters.partition_count}}",
          "batch_date": "{{job.parameters.batch_date}}",
          "max_errors": "{{job.parameters.max_errors}}",
          "checkpoint_dir": "{{job.parameters.checkpoint_dir}}/production",
          "log_level": "{{job.parameters.log_level}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    }
  ],
  "email_notifications": {
    "on_failure": ["data-engineering-alerts@company.com"],
    "on_start": [],
    "on_success": [],
    "no_alert_for_skipped_runs": true
  },
  "webhook_notifications": {
    "on_failure": [
      {
        "id": "slack_data_engineering_alerts"
      }
    ]
  },
  "format": "MULTI_TASK"
}
