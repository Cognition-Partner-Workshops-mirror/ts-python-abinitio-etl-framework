{
  "_comment": [
    "Databricks Workflow definition for the daily orders pipeline.",
    "Migrated from: scripts/run_daily_orders.ksh",
    "",
    "Original KornShell pipeline phases:",
    "  Phase 1: air sandbox run extract_orders.mp       → Task: extract_orders",
    "  Phase 2: air sandbox run cdc_orders.mp            → Task: cdc_orders",
    "  Phase 3: air sandbox run load_staging_orders.mp   → Task: load_staging_orders",
    "  Phase 4: air sandbox run prod_rollover_orders.mp  → Task: load_production_orders",
    "",
    "Original AutoSys job name: JOB_DAILY_ORDERS_LOAD",
    "Original schedule: Daily (triggered by AutoSys)",
    "Original environment sourcing: . /opt/abinitio/setenv.ksh",
    "",
    "PSET parameter mapping:",
    "  PSET: SOURCE_PATH       → job_parameter: source_path",
    "  PSET: TARGET_TABLE       → job_parameter: target_table",
    "  PSET: PARTITION_COUNT    → job_parameter: partition_count",
    "  PSET: BATCH_SIZE         → job_parameter: batch_size",
    "  PSET: MAX_ERRORS         → job_parameter: max_errors",
    "  PSET: LOG_LEVEL          → job_parameter: log_level",
    "  PSET: BATCH_DATE         → job_parameter: batch_date (auto-set to {{start_date}})"
  ],
  "name": "daily_orders_pipeline",
  "description": "Daily orders ETL pipeline — extract → CDC → staging → production. Migrated from Ab Initio KornShell orchestration (scripts/run_daily_orders.ksh).",
  "tags": {
    "team": "data-engineering",
    "source": "abinitio-migration",
    "legacy_job": "JOB_DAILY_ORDERS_LOAD",
    "pipeline": "orders"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED",
    "_comment": "Runs daily at 02:00 UTC — matches the original AutoSys schedule for JOB_DAILY_ORDERS_LOAD"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 4,
        "spark_conf": {
          "spark.sql.shuffle.partitions": "8",
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        },
        "custom_tags": {
          "pipeline": "daily_orders",
          "cost_center": "data-engineering"
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "source_path",
      "default": "/mnt/raw/orders",
      "_pset_source": "orders_pipeline.pset → SOURCE_PATH"
    },
    {
      "name": "target_table",
      "default": "catalog.bronze.orders",
      "_pset_source": "orders_pipeline.pset → TARGET_TABLE"
    },
    {
      "name": "staging_table",
      "default": "catalog.staging.orders",
      "_pset_source": "orders_staging.pset → TARGET_TABLE"
    },
    {
      "name": "production_table",
      "default": "catalog.gold.orders",
      "_pset_source": "orders_staging.pset → derived from TARGET_TABLE"
    },
    {
      "name": "partition_count",
      "default": "4",
      "_pset_source": "orders_pipeline.pset → PARTITION_COUNT"
    },
    {
      "name": "batch_size",
      "default": "50000",
      "_pset_source": "orders_pipeline.pset → BATCH_SIZE"
    },
    {
      "name": "max_errors",
      "default": "100",
      "_pset_source": "orders_pipeline.pset → MAX_ERRORS"
    },
    {
      "name": "log_level",
      "default": "INFO",
      "_pset_source": "orders_pipeline.pset → LOG_LEVEL"
    },
    {
      "name": "batch_date",
      "default": "{{start_date}}",
      "_pset_source": "run_daily_orders.ksh → BATCH_DATE=$(date +%Y-%m-%d)"
    }
  ],
  "tasks": [
    {
      "task_key": "extract_orders",
      "description": "Phase 1: Extract from source systems. Replaces: air sandbox run extract_orders.mp -pset orders_extract.pset",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/data-engineering/abinitio-migration/databricks/notebooks/parallel_loader",
        "base_parameters": {
          "source_path": "{{job.parameters.source_path}}",
          "target_table": "{{job.parameters.staging_table}}",
          "partition_count": "{{job.parameters.partition_count}}",
          "batch_size": "{{job.parameters.batch_size}}",
          "max_errors": "{{job.parameters.max_errors}}",
          "batch_date": "{{job.parameters.batch_date}}",
          "log_level": "{{job.parameters.log_level}}"
        }
      },
      "timeout_seconds": 1800,
      "retry_on_timeout": false,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "cdc_orders",
      "description": "Phase 2: CDC detection. Replaces: air sandbox run cdc_orders.mp -pset orders_cdc.pset -partition 4",
      "depends_on": [
        {"task_key": "extract_orders"}
      ],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/data-engineering/abinitio-migration/databricks/notebooks/cdc_processor",
        "base_parameters": {
          "source_path": "{{job.parameters.staging_table}}",
          "target_table": "{{job.parameters.target_table}}",
          "key_columns": "order_id",
          "hash_columns": "order_id,customer_id,total_amount,status,order_date",
          "partition_count": "{{job.parameters.partition_count}}",
          "max_errors": "{{job.parameters.max_errors}}",
          "run_timestamp": "{{job.parameters.batch_date}}"
        }
      },
      "timeout_seconds": 1800,
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "load_staging_orders",
      "description": "Phase 3: Staging load. Replaces: air sandbox run load_staging_orders.mp -pset orders_staging.pset. In Delta Lake architecture, staging is handled by the MERGE in the CDC step; this task runs data quality checks.",
      "depends_on": [
        {"task_key": "cdc_orders"}
      ],
      "job_cluster_key": "etl_cluster",
      "sql_task": {
        "query": {
          "query_string": "SELECT COUNT(*) as row_count, COUNT(DISTINCT order_id) as unique_orders, SUM(CASE WHEN order_id IS NULL THEN 1 ELSE 0 END) as null_keys FROM {{job.parameters.target_table}} WHERE _batch_date = '{{job.parameters.batch_date}}'"
        },
        "warehouse_id": "auto"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "load_production_orders",
      "description": "Phase 4: Production rollover. Replaces: air sandbox run prod_rollover_orders.mp -pset orders_prod.pset. Promotes validated data from bronze to gold layer.",
      "depends_on": [
        {"task_key": "load_staging_orders"}
      ],
      "job_cluster_key": "etl_cluster",
      "sql_task": {
        "query": {
          "query_string": "CREATE OR REPLACE TABLE {{job.parameters.production_table}} AS SELECT * EXCEPT (_ingested_at, _source_file, _record_hash) FROM {{job.parameters.target_table}} WHERE _batch_date = '{{job.parameters.batch_date}}'"
        },
        "warehouse_id": "auto"
      },
      "timeout_seconds": 1200
    }
  ],
  "email_notifications": {
    "on_failure": ["data-engineering-alerts@company.com"],
    "on_success": [],
    "no_alert_for_skipped_runs": true
  },
  "webhook_notifications": {
    "on_failure": [
      {
        "id": "slack_webhook_id",
        "_comment": "Replaces Ab Initio JobMonitor._send_alert() Slack webhook"
      }
    ]
  }
}
